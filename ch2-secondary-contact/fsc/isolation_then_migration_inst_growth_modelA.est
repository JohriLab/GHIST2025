// Priors and rules file 
// *********************  

[PARAMETERS]
//#isInt? #name   #dist.#min  #max 
//all N are in number of haploid individuals 
1  ANCSIZE1$     unif     100  1000000   output
1  ANCSIZE2$     unif     100  1000000   output
1  NCUR1$       unif     100  1000000   output
1  NCUR2$       unif     100  1000000   output
0  N1mig21$       logunif  1e-2 20       hide
0  N2mig12$       logunif  1e-2 20       hide
1  TMIG$        unif     100   1e5   output
1  TCHANGE1$        unif     100   1e5   output
1  TCHANGE2$        unif     100   1e5   output
1  TDIV$        unif     100   1e5   output

[COMPLEX PARAMETERS]

0  RESIZE1$ = ANCSIZE1$/NCUR1$     hide
0  RESIZE2$ = ANCSIZE2$/NCUR2$     hide
0  m21$  = N1mig21$/NCUR1$       output
0  m12$  = N2mig12$/NCUR2$       output 
